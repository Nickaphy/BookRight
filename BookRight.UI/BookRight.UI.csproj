<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>cdaecef2-c5ed-4762-9c8f-5a9e65fbbe33</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookRight.Application\BookRight.Application.csproj" />
    <ProjectReference Include="..\BookRight.Facade\BookRight.Facade.csproj" />
    <ProjectReference Include="..\BookRight.Infrastructure\BookRight.Infrastructure.csproj" />
  </ItemGroup>

</Project>
