@using BookRight.Facade.Commands.Booking
@using BookRight.Facade.Dtos.BookingCommand
@using BookRight.Facade.Dtos.BookingQuery
@using BookRight.Facade.Queries.BookingQueries

@rendermode InteractiveServer
@page "/bookings"
@namespace BookRight.UI.Components.Pages
@implements IDisposable

@inject IBookingQueries BookingQueries
@inject ICompleteBookingUseCase CompleteBooking
@inject IMarkAsNoShowUseCase MarkAsNoShow
@inject ICancelBookingFacade CancelBooking

<div class="bookings-page">
    <h1 class="bookings-heading">Bookinger</h1>
    <p class="bookings-period">@_periodLabel</p>

    @if (_bookings is null)
    {
        <p class="loading-text">Henter bookinger...</p>
    }
    else if (_bookings.Count == 0)
    {
        <p class="empty-text">Ingen bookinger i den valgte periode.</p>
    }
    else
    {
        <div class="clinics-grid">
            @foreach (var clinicGroup in _bookings.GroupBy(b => b.ClinicName).OrderBy(g => g.Key))
            {
                <div class="clinic-card">
                    <div class="clinic-card__header">
                        <span class="clinic-card__name">@clinicGroup.Key</span>
                        <span class="clinic-card__count">@clinicGroup.Count() booking@(clinicGroup.Count() != 1 ? "s" : "")</span>
                    </div>
                    <div class="clinic-card__body">
                        @foreach (var dayGroup in clinicGroup.GroupBy(b => b.StartTime.Date).OrderBy(g => g.Key))
                        {
                            <div class="day-section">
                                <div class="day-label">@FormatDayHeader(dayGroup.Key)</div>
                                @foreach (var booking in dayGroup.OrderBy(b => b.StartTime))
                                {
                                    var isPast = booking.EndTime < _now;
                                    var isToday = booking.StartTime.Date == DateTime.Today;
                                    <div class="booking-row @(isPast ? "booking-row--done" : "") @(isToday ? "booking-row--today" : "")"
                                         @onclick="() => OpenDetail(booking)">
                                        <span class="booking-row__time">@booking.StartTime.ToString("HH:mm") – @booking.EndTime.ToString("HH:mm")</span>
                                        <span class="booking-row__customer">@booking.CustomerName</span>
                                        <span class="booking-row__treatment">@booking.TreatmentName</span>
                                        <span class="booking-row__status @StatusCss(booking.Status, isPast)">@StatusLabel(booking.Status, isPast)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Detail popup ── *@
@if (_detailBooking is not null)
{
    <div class="br-overlay" @onclick="CloseDetail">
        <div class="br-popup" @onclick:stopPropagation="true">

            <div class="br-popup__header">
                <h2 class="br-popup__title">Bookingdetaljer</h2>
                <button class="br-popup__close" @onclick="CloseDetail">&#x2715;</button>
            </div>

            <div class="br-popup__body">
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Patient</span>
                    <span class="br-detail-row__value">@_detailBooking.CustomerName</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Behandling</span>
                    <span class="br-detail-row__value">@_detailBooking.TreatmentName</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Terapeut</span>
                    <span class="br-detail-row__value">@_detailBooking.PractitionerName</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Klinik</span>
                    <span class="br-detail-row__value">@_detailBooking.ClinicName</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Dato</span>
                    <span class="br-detail-row__value">@FormatFullDate(_detailBooking.StartTime)</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Tidspunkt</span>
                    <span class="br-detail-row__value">@_detailBooking.StartTime.ToString("HH:mm") – @_detailBooking.EndTime.ToString("HH:mm")</span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Pris</span>
                    <span class="br-detail-row__value">
                        @_detailBooking.FinalPrice.ToString("N2") DKK
                        @if (_detailBooking.DiscountType != "None")
                        {
                            <span class="br-discount-tag">@DiscountLabel(_detailBooking.DiscountType)</span>
                        }
                    </span>
                </div>
                <div class="br-detail-row">
                    <span class="br-detail-row__label">Status</span>
                    <span class="br-detail-row__value">@StatusLabel(_detailBooking.Status, _detailBooking.EndTime < _now)</span>
                </div>
            </div>

            @* Actions: only available while booking is still Created.
               Past Created → receptionist chooses outcome (Complete / NoShow).
               Future Created → can only be Cancelled.
               Once a final status is set, no further changes are possible. *@
            @* Ongoing or past Created: receptionist can complete or mark no-show
               as soon as the appointment has started (StartTime < now). *@
            @if (_detailBooking.Status == "Created" && _detailBooking.StartTime < _now)
            {
                <div class="br-popup__actions">
                    <button class="br-btn-complete" @onclick="CompleteAsync" disabled="@_isActing">Afslut booking</button>
                    <button class="br-btn-noshow" @onclick="MarkNoShowAsync" disabled="@_isActing">Udeblevet</button>
                </div>
            }

            @* Upcoming Created: appointment hasn't started yet — can only be cancelled *@
            @if (_detailBooking.Status == "Created" && _detailBooking.StartTime >= _now)
            {
                <div class="br-popup__actions">
                    <button class="br-btn-cancel" @onclick="CancelAsync" disabled="@_isActing">Aflys booking</button>
                </div>
            }

            @* Completed: can be corrected to no-show *@
            @if (_detailBooking.Status == "Completed")
            {
                <div class="br-popup__actions">
                    <button class="br-btn-noshow" @onclick="MarkNoShowAsync" disabled="@_isActing">Ret til udeblevet</button>
                </div>
            }

            @if (_actionError is not null)
            {
                <p class="br-action-error">@_actionError</p>
            }

            <div class="br-popup__footer">
                <button class="br-btn-close" @onclick="CloseDetail">Luk</button>
            </div>

        </div>
    </div>
}

@code {
    private List<BookingDto>? _bookings;
    private string _periodLabel = string.Empty;
    private DateTime _now = DateTime.Now;
    private Timer? _timer;
    private BookingDto? _detailBooking;
    private bool _isActing;
    private string? _actionError;

    protected override async Task OnInitializedAsync()
    {
        var from = DateTime.Today;
        var to = from.AddDays(30);
        _periodLabel = $"{FormatDate(from)} \u2013 {FormatDate(to.AddDays(-1))}";
        _bookings = (await BookingQueries.GetBookingsForPeriodAsync(from, to)).ToList();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        // Refresh _now every minute so the day/time labels stay current.
        // Status changes are manual — the receptionist decides the outcome.
        _timer = new Timer(_ =>
        {
            InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); return Task.CompletedTask; });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    public void Dispose() => _timer?.Dispose();

    private void OpenDetail(BookingDto booking)
    {
        _detailBooking = booking;
        _actionError = null;
    }

    private void CloseDetail()
    {
        _detailBooking = null;
        _actionError = null;
    }

    private async Task CompleteAsync()
    {
        if (_detailBooking is null) return;
        _isActing = true;
        _actionError = null;
        try
        {
            await CompleteBooking.ExecuteAsync(new CompleteBookingRequest(_detailBooking.Id));
            UpdateLocalStatus(_detailBooking.Id, "Completed");
            CloseDetail();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _isActing = false; }
    }

    private async Task MarkNoShowAsync()
    {
        if (_detailBooking is null) return;
        _isActing = true;
        _actionError = null;
        try
        {
            await MarkAsNoShow.ExecuteAsync(new MarkAsNoShowRequest(_detailBooking.Id));
            UpdateLocalStatus(_detailBooking.Id, "NoShow");
            CloseDetail();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _isActing = false; }
    }

    private async Task CancelAsync()
    {
        if (_detailBooking is null) return;
        _isActing = true;
        _actionError = null;
        try
        {
            await CancelBooking.ExecuteAsync(new CancelBookingRequest(_detailBooking.Id));
            UpdateLocalStatus(_detailBooking.Id, "Cancelled");
            CloseDetail();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _isActing = false; }
    }

    private void UpdateLocalStatus(Guid id, string newStatus)
    {
        if (_bookings is null) return;
        var idx = _bookings.FindIndex(b => b.Id == id);
        if (idx >= 0)
            _bookings[idx] = _bookings[idx] with { Status = newStatus };
    }

    private static string StatusLabel(string status, bool isPast) => status switch
    {
        "Completed" => "Afsluttet",
        "Cancelled" => "Aflyst",
        "NoShow" => "Udeblevet",
        // Created: show "Afventer" for upcoming, "Ikke behandlet" for past
        _ => isPast ? "Ikke behandlet" : "Aktiv"
    };

    private static string StatusCss(string status, bool isPast) => status switch
    {
        "Completed" => "status--done",
        "Cancelled" => "status--cancelled",
        "NoShow" => "status--noshow",
        _ => isPast ? "status--pending" : "status--active"
    };

    private static string DiscountLabel(string discountType) => discountType switch
    {
        "Bronze" => "Bronze 5%",
        "Silver" => "S\u00f8lv 10%",
        "Gold" => "Guld 15%",
        "BirthdayMonth" => "F\u00f8dselsdag 25%",
        "Campaign" => "Kampagne",
        _ => string.Empty
    };

    private static string FormatDayHeader(DateTime date)
    {
        var today = date.Date == DateTime.Today ? " \u2013 I DAG" : string.Empty;
        return $"{DayName(date.DayOfWeek)} D. {date.Day}. {MonthName(date.Month).ToUpper()}{today}";
    }

    private static string FormatFullDate(DateTime dt) =>
        $"{DayName(dt.DayOfWeek)} den {dt.Day}. {MonthName(dt.Month)} {dt.Year}";

    private static string FormatDate(DateTime dt) =>
        $"{dt.Day}. {MonthName(dt.Month)} {dt.Year}";

    private static string DayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Mandag",
        DayOfWeek.Tuesday => "Tirsdag",
        DayOfWeek.Wednesday => "Onsdag",
        DayOfWeek.Thursday => "Torsdag",
        DayOfWeek.Friday => "Fredag",
        DayOfWeek.Saturday => "L\u00f8rdag",
        DayOfWeek.Sunday => "S\u00f8ndag",
        _ => string.Empty
    };

    private static string MonthName(int m) => m switch
    {
        1 => "januar",
        2 => "februar",
        3 => "marts",
        4 => "april",
        5 => "maj",
        6 => "juni",
        7 => "juli",
        8 => "august",
        9 => "september",
        10 => "oktober",
        11 => "november",
        12 => "december",
        _ => string.Empty
    };
}
