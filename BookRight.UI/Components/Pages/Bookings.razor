@using BookRight.Facade.Commands.Booking
@using BookRight.Facade.Dtos.BookingCommand
@using BookRight.Facade.Dtos.BookingQuery
@using BookRight.Facade.Queries.BookingQueries

@rendermode InteractiveServer
@page "/bookings"
@namespace BookRight.UI.Components.Pages
@implements IDisposable

@inject IBookingQueries BookingQueries
@inject ICompleteBookingUseCase CompleteBooking

<h1>@_heading</h1>

@if (_bookings is null)
{
    <p>Henter bookinger...</p>
}
else if (_bookings.Count == 0)
{
    <p>Ingen bookinger</p>
}
else
{
    <div class="booking-list">
        @foreach (var booking in _bookings)
        {
            var completed = booking.EndTime < _now;
            <div class="booking-row @(completed ? "booking-done" : "booking-active")">
                <span class="booking-time">@booking.StartTime.ToString("HH:mm") – @booking.EndTime.ToString("HH:mm")</span>
                <span class="booking-customer">@booking.CustomerName</span>
                <span class="booking-treatment">@booking.TreatmentName</span>
                <span class="booking-status">@(completed ? "Afsluttet" : booking.Status)</span>
            </div>
        }
    </div>
}

<style>
    .booking-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: 700px;
    }

    .booking-row {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .booking-active {
        background: #f0f7ff;
        border-left: 4px solid #2563eb;
        color: #1e293b;
    }

    .booking-done {
        background: #f5f5f5;
        border-left: 4px solid #cbd5e1;
        color: #94a3b8;
    }

    .booking-time {
        font-weight: 600;
        min-width: 110px;
    }

    .booking-customer {
        min-width: 160px;
    }

    .booking-treatment {
        flex: 1;
    }

    .booking-status {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
</style>

@code {
    private List<BookingDto>? _bookings;
    private string _heading = string.Empty;
    private DateTime _now = DateTime.Now;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _heading = BuildHeading();
        _bookings = (await BookingQueries.GetTodaysBookingsAsync()).ToList();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        _timer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                _now = DateTime.Now;

                if (_bookings is not null)
                {
                    for (var i = 0; i < _bookings.Count; i++)
                    {
                        var b = _bookings[i];
                        if (b.EndTime < _now && b.Status != "Completed")
                        {
                            await CompleteBooking.ExecuteAsync(new CompleteBookingRequest(b.Id));
                            _bookings[i] = b with { Status = "Completed" };
                        }
                    }
                }

                StateHasChanged();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private static string BuildHeading()
    {
        var now = DateTime.Now;
        var dayName = now.DayOfWeek switch
        {
            DayOfWeek.Monday    => "Mandag",
            DayOfWeek.Tuesday   => "Tirsdag",
            DayOfWeek.Wednesday => "Onsdag",
            DayOfWeek.Thursday  => "Torsdag",
            DayOfWeek.Friday    => "Fredag",
            DayOfWeek.Saturday  => "Lørdag",
            DayOfWeek.Sunday    => "Søndag",
            _                   => string.Empty
        };
        return $"{dayName} d. {now.Day}. {MonthName(now.Month)} {now.Year}";
    }

    private static string MonthName(int month) => month switch
    {
        1  => "januar",
        2  => "februar",
        3  => "marts",
        4  => "april",
        5  => "maj",
        6  => "juni",
        7  => "juli",
        8  => "august",
        9  => "september",
        10 => "oktober",
        11 => "november",
        12 => "december",
        _  => string.Empty
    };
}
